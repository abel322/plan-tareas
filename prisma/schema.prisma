generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String        @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               String        @default("USER")
  isTwoFactorEnabled Boolean       @default(false)
  twoFactorSecret    String?
  projects           Project[]
  tasks              Task[]
  activityLogs       ActivityLog[]
  userSessions       UserSession[]
  quickNotes         QuickNote[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent   String?
  ipAddress   String?
  isCurrent   Boolean  @default(false)
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  objective   String?
  priority    String      @default("MEDIUM")
  status      String      @default("PLANNING")
  startDate   DateTime?
  endDate     DateTime?
  progress    Float       @default(0)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectives    Objective[]
  specificGoals SpecificGoal[]
  tasks         Task[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Objective {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specific   String
  measurable String
  achievable String
  relevant   String
  timeBound  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SpecificGoal {
  id            String         @id @default(cuid())
  name          String
  description   String?
  priority      String         @default("MEDIUM")
  status        String         @default("TODO")
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorId String?
  predecessor   SpecificGoal?  @relation("GoalSequence", fields: [predecessorId], references: [id], onDelete: SetNull)
  successors    SpecificGoal[] @relation("GoalSequence")
  tasks         Task[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Task {
  id                String           @id @default(cuid())
  name              String
  description       String?
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specificGoalId    String?
  specificGoal      SpecificGoal?    @relation(fields: [specificGoalId], references: [id], onDelete: SetNull)
  assigneeId        String?
  assignee          User?            @relation(fields: [assigneeId], references: [id])
  priority          String           @default("MEDIUM")
  status            String           @default("TODO")
  startDate         DateTime?
  endDate           DateTime?
  estimatedDuration Float            @default(0)
  // Campos PERT (Program Evaluation and Review Technique)
  optimisticTime    Float?
  mostLikelyTime    Float?
  pessimisticTime   Float?
  tags              String?
  // Campos CPM (Critical Path Method)
  earlyStart        Float?           // ES: Tiempo de inicio temprano
  lateStart         Float?           // LS: Tiempo de inicio tardío
  slack             Float?           // Holgura total (LS - ES)
  isCritical        Boolean          @default(false)
  dependencies      Dependency[]     @relation("TaskDependencies")
  dependents        Dependency[]     @relation("DependentTasks")
  pertEstimation    PERTEstimation?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Dependency {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("DependentTasks", fields: [dependsOnId], references: [id], onDelete: Cascade)
  type        String   @default("FINISH_TO_START")
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
}

model PERTEstimation {
  id          String   @id @default(cuid())
  taskId      String   @unique
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  optimistic  Float
  mostLikely  Float
  pessimistic Float
  expectedTime Float
  variance    Float
  standardDev Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String
  metadata  String?
  createdAt DateTime @default(now())
}

model QuickNote {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

